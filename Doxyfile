# Doxygen configuration for REAL — the exhaustive developer tree (`make doc`).
# Style: banner-block comments whose first sentence is the brief (no autobrief),
# in-place attribute docs (`//!<`), and exhaustive extraction of the whole library.
#
# TWO PROFILES. This file is the developer tree: INTERNAL_DOCS=YES, private
# members extracted, HTML at build/doc/html (copied to the site as /api).
# Doxyfile.site is the user tree Breathe consumes (XML only, build/doc/xml-site).
# \internal hides a comment, not a symbol -- Doxyfile.site excludes engine
# hooks by EXCLUDE_SYMBOLS and #ifndef DOXYGEN_SHOULD_SKIP_THIS. Do not
# point conf.py at this file's XML.

PROJECT_NAME           = "REAL"
PROJECT_BRIEF          = "Regular Expression Algorithmic Library — constexpr C++20 regex"
OUTPUT_DIRECTORY       = build/doc
OUTPUT_LANGUAGE        = English

# --- what to document ------------------------------------------------------
INPUT                  = include/real README.md docs/
FILE_PATTERNS          = *.hpp *.dox *.md
# docs/site is the Sphinx/MyST landing -- its .md is MyST syntax, not
# Doxygen-markdown, and RECURSIVE + *.md below would otherwise ingest it into the LIVE
# Doxygen site and break `make doc` under WARN_AS_ERROR the moment the first MyST page
# lands. Same precedent as docs/release-notes.
EXCLUDE                = docs/README.md docs/release-notes docs/site
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
# NO, deliberately: YES extracts undocumented entities as if documented, which SILENTLY
# neutralises WARN_IF_UNDOCUMENTED below -- the gate reported clean while the tree carried
# 895 undocumented members. With NO the two settings work together and `make doc-check`
# fails on the first entity that loses its comment. Do not set this back to YES to quiet a
# warning: document the entity instead.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
INTERNAL_DOCS          = YES

# --- comment interpretation ------------------------------------------------
# Banner-block style: the first sentence of a /*! */ block is the brief.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
# C++20 / templates / constexpr are not C; keep full C++ output.
OPTIMIZE_OUTPUT_FOR_C  = NO

# --- diagnostics: keep the doc honest (warn on undocumented members) -------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
# Fail the build on any warning (after listing them all), so the doc gate enforces
# the zero-warning discipline rather than printing warnings that slip through.
WARN_AS_ERROR          = FAIL_ON_WARNINGS

# --- output ----------------------------------------------------------------
# MathJax renders the LaTeX in the design guide client-side (no local LaTeX).
USE_MATHJAX            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
# NO at publication: *_source.html was 9 MiB of the published /api tree and
# the 13 largest pages. SOURCE_BROWSER=NO alone is not enough -- Doxygen's
# default VERBATIM_HEADERS=YES still emits one *_source.html per header
# (measured: 36 files, 9.1 MiB, after SOURCE_BROWSER flipped). The headers
# live on GitHub; the curated /reference/ pages do not need a second copy.
# `make doc` shares this file.
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO
ALPHABETICAL_INDEX     = YES
# XML sidecar for check-doc-style (member kinds, the full tree). Breathe does
# NOT read this directory -- see Doxyfile.site / build/doc/xml-site.
GENERATE_XML           = YES
XML_OUTPUT             = xml

# --- theme: native Doxygen (light/dark) ------------------------------------
# Doxygen's built-in theme (>= 1.9.6). Self-consistent on every version — it renders the same
# on the local Doxygen and on CI's 1.9.8, with no third-party skew (a vendored theme designed
# for an older Doxygen broke under a newer local one). TREEVIEW gives the navigation sidebar.
# AUTO_LIGHT follows the OS preference (light by default), so the main page AND the llvm-cov
# coverage iframe both key off prefers-color-scheme and stay harmonized — docs/coverage-style.css
# was written exactly to match Doxygen's automatic dark. (A JS toggle could return later with an
# iframe-sync; deferred.)
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_LIGHT

# --- graphs (require Graphviz `dot`) ---------------------------------------
# Structural graphs (header include dependencies = the layering, plus
# collaboration diagrams) are generated automatically; call graphs are left
# off as they are noisy for this engine.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
# NO: INTERACTIVE_SVG=YES emits a sibling *_org.svg per graph (~2 MiB of
# duplicates on the published /api tree) for a hover the site does not use.
INTERACTIVE_SVG        = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# --- preprocessing: expand the library's feature macros sensibly -----------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
